# Proxy local du test : simule le client patché (D1). Seule la création de
# tunnel (POST /api/tunnel) reçoit le token Logto (ici le token du faux
# authorize) ; les autres appels gardent leur Authorization (token rly_).
{
	admin off
	auto_https off
}

http://127.0.0.1:18080 {
	@create {
		method POST
		path /api/tunnel
	}
	handle @create {
		reverse_proxy https://share.dev.devver.app {
			header_up Host share.dev.devver.app
			header_up Authorization "Bearer {env.OT_TEST_TOKEN}"
		}
	}
	handle {
		reverse_proxy https://share.dev.devver.app {
			header_up Host share.dev.devver.app
		}
	}
}
